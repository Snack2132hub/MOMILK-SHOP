# Copy to .env.local for local development.
# Use the Supabase Project URL and publishable/anon key only in frontend variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never put SUPABASE_SERVICE_ROLE_KEY or any secret key in a VITE_ variable.
