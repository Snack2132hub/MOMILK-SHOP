# Preferred names for local development
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# On Vercel, frontend/vite.config.ts also accepts the existing names:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# IMPORTANT: the key exposed to the browser must be the publishable/anon key.
# Never put a service-role/secret key in either variable above.
